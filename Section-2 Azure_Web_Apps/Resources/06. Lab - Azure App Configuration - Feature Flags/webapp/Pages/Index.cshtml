@page
@model Pages.Orders.IndexModel
@using Microsoft.FeatureManagement
@inject IFeatureManager FeatureManager

<h2>Course Orders</h2>
@if (await FeatureManager.IsEnabledAsync("ShowDiscountBanner"))
{
    <div style="padding:10px;border:1px solid #ccc;margin-bottom:10px;">
        🎉 Discount Week: Use code CLOUDXEUS for 20% off!
    </div>
}


@if (Model.Orders.Count == 0)
{
    <p>No orders found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>OrderId</th>
                <th>Customer</th>
                <th>Email</th>
                <th>Course</th>
                <th>Amount</th>
                <th>Order Date (UTC)</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var o in Model.Orders)
        {
            <tr>
                <td>@o.OrderId</td>
                <td>@o.CustomerName</td>
                <td>@o.CustomerEmail</td>
                <td>@o.CourseName</td>
                <td>@o.Amount</td>
                <td>@o.OrderDateUtc.ToString("u")</td>
                <td>@(string.IsNullOrWhiteSpace(o.Notes) ? "-" : o.Notes)</td>
            </tr>
        }
        </tbody>
    </table>
}
